rules_version = '2';

// ROEYA Lumen — Firestore security rules.
// Paste into Firebase console → Firestore Database → Rules → Publish.
// Admins: create a document admins/{your-user-uid} in the console (any field).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function str(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function optStr(m, k, max) { return !(k in m) || (m[k] is string && m[k].size() <= max); }
    function isNow(v) { return v == request.time; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ---------- admins (managed in the console only) ----------
    match /admins/{uid} {
      allow get: if signedIn() && uid == me();
      allow list, write: if false;
    }

    // ---------- private per-user data: settings, progress, logbook, notes ----------
    match /users/{uid} {
      allow get: if signedIn() && (uid == me() || isAdmin());
      allow list: if isAdmin();
      allow create, update: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['stateJson', 'email', 'name', 'createdAt', 'updatedAt'])
        && (!('stateJson' in request.resource.data) || (request.resource.data.stateJson is string && request.resource.data.stateJson.size() < 900000))
        && optStr(request.resource.data, 'email', 200) && optStr(request.resource.data, 'name', 120);
      allow delete: if false;
    }

    // ---------- public member profiles (visible to signed-in members) ----------
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['name', 'role', 'city', 'country', 'center', 'mods', 'kind', 'hue', 'bio', 'verified', 'joined'])
        && str(request.resource.data.name, 120)
        && request.resource.data.verified == false
        && request.resource.data.kind in ['Fellow', 'Nurse', 'Member']
        && optStr(request.resource.data, 'role', 120) && optStr(request.resource.data, 'city', 120)
        && optStr(request.resource.data, 'country', 80) && optStr(request.resource.data, 'center', 160)
        && optStr(request.resource.data, 'bio', 1000)
        && (!('mods' in request.resource.data) || (request.resource.data.mods is list && request.resource.data.mods.size() <= 20));
      allow update: if isAdmin() || (signedIn() && uid == me()
        && !changed().hasAny(['verified', 'kind', 'joined'])
        && request.resource.data.keys().hasOnly(['name', 'role', 'city', 'country', 'center', 'mods', 'kind', 'hue', 'bio', 'verified', 'joined'])
        && str(request.resource.data.name, 120) && optStr(request.resource.data, 'bio', 1000));
      allow delete: if isAdmin();
    }

    // ---------- community feed ----------
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.keys().hasOnly(['by', 'text', 'tags', 'at'])
        && request.resource.data.by == me()
        && str(request.resource.data.text, 5000)
        && request.resource.data.tags is list && request.resource.data.tags.size() <= 5
        && isNow(request.resource.data.at));
      allow update: if isAdmin() || (signedIn() && resource.data.by == me()
        && changed().hasOnly(['text', 'tags']) && str(request.resource.data.text, 5000));
      allow delete: if isAdmin() || (signedIn() && resource.data.by == me());

      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && uid == me() && request.resource.data.keys().hasOnly(['at']);
        allow delete: if signedIn() && uid == me();
      }
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['by', 'text', 'at'])
          && request.resource.data.by == me()
          && str(request.resource.data.text, 2000)
          && isNow(request.resource.data.at);
        allow delete: if isAdmin() || (signedIn() && resource.data.by == me());
      }
      match /votes/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && uid == me()
          && request.resource.data.keys().hasOnly(['i', 'at'])
          && request.resource.data.i is int && request.resource.data.i >= 0 && request.resource.data.i < 10;
        allow delete: if signedIn() && uid == me();
      }
    }
    // collection-group reads used to count likes, comments and votes in one listener each
    match /{path=**}/likes/{uid} { allow read: if signedIn(); }
    match /{path=**}/comments/{commentId} { allow read: if signedIn(); }
    match /{path=**}/votes/{uid} { allow read: if signedIn(); }

    // ---------- direct messages: id = "uidA_uidB" (sorted) ----------
    match /conversations/{cid} {
      allow get: if signedIn() && me() in cid.split('_');
      allow list: if signedIn() && me() in resource.data.members;
      allow create: if signedIn() && me() in cid.split('_')
        && request.resource.data.keys().hasOnly(['members', 'createdAt'])
        && request.resource.data.members == cid.split('_')
        && request.resource.data.members.size() == 2;
      allow update: if signedIn() && me() in resource.data.members
        && changed().hasOnly(['last', 'lastBy', 'lastAt'])
        && request.resource.data.lastBy == me()
        && str(request.resource.data.last, 140);
      allow delete: if false;

      match /messages/{mid} {
        allow read: if signedIn() && me() in cid.split('_');
        allow create: if signedIn() && me() in cid.split('_')
          && request.resource.data.keys().hasOnly(['by', 'text', 'at'])
          && request.resource.data.by == me()
          && str(request.resource.data.text, 2000)
          && isNow(request.resource.data.at);
        allow update, delete: if false;
      }
    }

    // ---------- questions under videos ----------
    match /qa/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['vid', 'by', 'text', 'at'])
        && request.resource.data.by == me()
        && str(request.resource.data.vid, 80) && str(request.resource.data.text, 2000)
        && isNow(request.resource.data.at);
      allow delete: if isAdmin() || (signedIn() && resource.data.by == me());
    }

    // ---------- forms read by ROEYA staff ----------
    match /consults/{id} {
      allow create: if signedIn() && request.resource.data.uid == me() && isNow(request.resource.data.at)
        && str(request.resource.data.summary, 5000) && request.resource.data.status == 'requested';
      allow read: if isAdmin() || (signedIn() && resource.data.uid == me());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /requests/{id} {
      allow create: if signedIn() && request.resource.data.uid == me() && isNow(request.resource.data.at)
        && request.resource.data.kind in ['session', 'order', 'programme', 'event'];
      allow read, update, delete: if isAdmin();
    }
    match /newsletter/{id} {
      // also allowed from the public home page (not signed in)
      allow create: if request.resource.data.keys().hasOnly(['email', 'topics', 'freq', 'lang', 'source', 'uid', 'at'])
        && str(request.resource.data.email, 200)
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && isNow(request.resource.data.at)
        && (request.resource.data.uid == null || (signedIn() && request.resource.data.uid == me()));
      allow read, update, delete: if isAdmin();
    }
    match /verifications/{uid} {
      allow create, update: if (signedIn() && uid == me() && request.resource.data.uid == me()
          && request.resource.data.status == 'pending'
          && (!('file' in request.resource.data) || (request.resource.data.file is string && request.resource.data.file.size() < 950000)))
        || isAdmin();
      allow read: if isAdmin() || (signedIn() && uid == me());
      allow delete: if isAdmin();
    }
    match /passports/{id} {
      allow create: if signedIn() && request.resource.data.uid == me() && isNow(request.resource.data.at)
        && str(request.resource.data.code, 40)
        && exists(/databases/$(database)/documents/codes/$(request.resource.data.code));
      allow read: if isAdmin() || (signedIn() && resource.data.uid == me());
      allow update, delete: if isAdmin();
    }
    match /codes/{code} {
      allow get: if signedIn();
      allow list, write: if isAdmin();
    }

    // everything else: closed
  }
}
